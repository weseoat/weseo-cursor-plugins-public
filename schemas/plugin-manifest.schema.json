{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://weseo.internal/schemas/plugin-manifest.schema.json",
  "title": "WESEO Cursor Plugin Manifest",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "name",
    "displayName",
    "version",
    "responsibility",
    "assumptions",
    "rules",
    "skills",
    "releaseNotes"
  ],
  "properties": {
    "$schema": {
      "type": "string"
    },
    "name": {
      "type": "string",
      "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
    },
    "displayName": {
      "type": "string",
      "minLength": 1
    },
    "version": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
    },
    "responsibility": {
      "type": "string",
      "minLength": 1
    },
    "assumptions": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "rules": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/includedContent"
      }
    },
    "skills": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/includedContent"
      }
    },
    "releaseNotes": {
      "type": "string",
      "minLength": 1
    }
  },
  "$defs": {
    "includedContent": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "path",
        "source",
        "description"
      ],
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1
        },
        "path": {
          "type": "string",
          "minLength": 1
        },
        "source": {
          "type": "string",
          "minLength": 1
        },
        "description": {
          "type": "string",
          "minLength": 1
        }
      }
    }
  }
}
