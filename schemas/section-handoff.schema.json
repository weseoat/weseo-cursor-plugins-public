{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://weseo.internal/schemas/section-handoff.schema.json",
  "title": "WESEO WST Section Handoff",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "handoffCarrier",
    "workflowRouting",
    "sectionIdentity",
    "discoverySources",
    "wordpressAndWstReferences",
    "cssHooks",
    "visualQaTargets",
    "serverPhaseResponsibilities",
    "frontendQaBrief",
    "localFrontendResponsibilities",
    "qaNotes",
    "openQuestions"
  ],
  "properties": {
    "handoffCarrier": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "project",
        "branchOrPr",
        "handoffFilename",
        "handoffStorageLocation",
        "handoffOwner",
        "serverPhaseStatus",
        "localFrontendPhaseStatus"
      ],
      "properties": {
        "project": { "type": "string", "minLength": 1 },
        "branchOrPr": { "type": "string", "minLength": 1 },
        "handoffFilename": { "type": "string", "minLength": 1 },
        "handoffStorageLocation": { "type": "string", "minLength": 1 },
        "handoffOwner": { "type": "string", "minLength": 1 },
        "serverPhaseStatus": { "type": "string", "minLength": 1 },
        "localFrontendPhaseStatus": { "type": "string", "minLength": 1 }
      }
    },
    "workflowRouting": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "workType",
        "environment",
        "serverWriteScope",
        "frontendRoute",
        "discoveryAndSafetyStatus",
        "liveOrUnknownWriteConfirmation",
        "cssStatus"
      ],
      "properties": {
        "workType": { "type": "string", "minLength": 1 },
        "environment": { "type": "string", "minLength": 1 },
        "serverWriteScope": { "type": "string", "minLength": 1 },
        "frontendRoute": { "type": "string", "minLength": 1 },
        "discoveryAndSafetyStatus": { "type": "string", "minLength": 1 },
        "liveOrUnknownWriteConfirmation": { "type": "string", "minLength": 1 },
        "cssStatus": { "type": "string", "minLength": 1 }
      }
    },
    "sectionIdentity": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "sectionName",
        "sectionSlug",
        "layoutName",
        "pageUrl",
        "previewUrls",
        "designDesktop",
        "designMobile",
        "sourceDesignStatus",
        "variantsStates"
      ],
      "properties": {
        "sectionName": { "type": "string", "minLength": 1 },
        "sectionSlug": { "type": "string", "minLength": 1 },
        "layoutName": { "type": "string", "minLength": 1 },
        "pageUrl": { "type": "string", "minLength": 1 },
        "previewUrls": { "type": "string", "minLength": 1 },
        "designDesktop": { "type": "string", "minLength": 1 },
        "designMobile": { "type": "string", "minLength": 1 },
        "sourceDesignStatus": { "type": "string", "minLength": 1 },
        "variantsStates": { "type": "string", "minLength": 1 }
      }
    },
    "discoverySources": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "originalFigmaSourceLinkDesktop",
        "originalFigmaSourceLinkMobile",
        "testPlacementTargetPage",
        "similarSectionPatternsInspected",
        "wstAcfRulesApplied",
        "mediaLibraryLookup",
        "projectLocalExamplesConsulted",
        "assumptionsRecorded"
      ],
      "properties": {
        "originalFigmaSourceLinkDesktop": { "type": "string", "minLength": 1 },
        "originalFigmaSourceLinkMobile": { "type": "string", "minLength": 1 },
        "testPlacementTargetPage": { "type": "string", "minLength": 1 },
        "similarSectionPatternsInspected": { "type": "string", "minLength": 1 },
        "wstAcfRulesApplied": { "type": "string", "minLength": 1 },
        "mediaLibraryLookup": { "type": "string", "minLength": 1 },
        "projectLocalExamplesConsulted": { "type": "string", "minLength": 1 },
        "assumptionsRecorded": { "type": "string", "minLength": 1 }
      }
    },
    "wordpressAndWstReferences": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "templateFile",
        "cssFile",
        "acfSectionFieldGroup",
        "acfFlexibleContentField",
        "acfFlexibleContentLayout",
        "acfCloneChildField",
        "acfFields",
        "contentSetupNotes"
      ],
      "properties": {
        "templateFile": { "type": "string", "minLength": 1 },
        "cssFile": { "type": "string", "minLength": 1 },
        "acfSectionFieldGroup": { "type": "string", "minLength": 1 },
        "acfFlexibleContentField": { "type": "string", "minLength": 1 },
        "acfFlexibleContentLayout": { "type": "string", "minLength": 1 },
        "acfCloneChildField": { "type": "string", "minLength": 1 },
        "acfFields": { "type": "string", "minLength": 1 },
        "contentSetupNotes": { "type": "string", "minLength": 1 }
      }
    },
    "protectedExistingArtifacts": {
      "type": "object",
      "additionalProperties": false,
      "description": "Filled for existing-section-remodel work types; values may be not-applicable otherwise.",
      "properties": {
        "existingLayoutName": { "type": "string", "minLength": 1 },
        "existingLayoutKey": { "type": "string", "minLength": 1 },
        "existingParentLayoutBinding": { "type": "string", "minLength": 1 },
        "existingAcfFieldKeys": { "type": "string", "minLength": 1 },
        "existingTemplatePath": { "type": "string", "minLength": 1 },
        "existingCssPath": { "type": "string", "minLength": 1 },
        "publicSelectorsToPreserve": { "type": "string", "minLength": 1 }
      }
    },
    "cssHooks": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "primarySectionClass",
        "wrapperClasses",
        "cssCustomProperties",
        "selectorsToPreserve"
      ],
      "properties": {
        "primarySectionClass": { "type": "string", "minLength": 1 },
        "wrapperClasses": { "type": "string", "minLength": 1 },
        "cssCustomProperties": { "type": "string", "minLength": 1 },
        "selectorsToPreserve": { "type": "string", "minLength": 1 }
      }
    },
    "visualQaTargets": {
      "type": "object",
      "additionalProperties": false,
      "required": ["viewports", "rows"],
      "properties": {
        "viewports": {
          "type": "object",
          "additionalProperties": false,
          "required": ["desktop", "tablet", "mobile"],
          "properties": {
            "desktop": { "type": "string", "minLength": 1 },
            "tablet": { "type": "string", "minLength": 1 },
            "mobile": { "type": "string", "minLength": 1 }
          }
        },
        "rows": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["variant", "viewport", "expectation", "result"],
            "properties": {
              "variant": { "type": "string", "minLength": 1 },
              "viewport": { "type": "string", "minLength": 1 },
              "expectation": { "type": "string", "minLength": 1 },
              "result": { "type": "string", "minLength": 1 }
            }
          },
          "allOf": [
            { "contains": { "type": "object", "properties": { "variant": { "const": "default" } }, "required": ["variant"] } },
            { "contains": { "type": "object", "properties": { "variant": { "const": "long headline/copy" } }, "required": ["variant"] } },
            { "contains": { "type": "object", "properties": { "variant": { "const": "optional field empty" } }, "required": ["variant"] } },
            { "contains": { "type": "object", "properties": { "variant": { "const": "many repeats" } }, "required": ["variant"] } },
            { "contains": { "type": "object", "properties": { "variant": { "const": "mobile stack" } }, "required": ["variant"] } },
            { "contains": { "type": "object", "properties": { "variant": { "const": "interaction states" } }, "required": ["variant"] } }
          ]
        }
      }
    },
    "serverPhaseResponsibilities": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string", "minLength": 1 }
    },
    "frontendQaBrief": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string", "minLength": 1 }
    },
    "localFrontendResponsibilities": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string", "minLength": 1 }
    },
    "qaNotes": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "browserQaTargetUrl",
        "localPlaywrightMcpStatus",
        "requiredViewports",
        "browserAccessBlockers",
        "screenshotPolicy",
        "checksToRun",
        "projectLocalPlaywrightCommand",
        "serverVerificationResult",
        "cacheState",
        "knownRisks",
        "qaResult"
      ],
      "properties": {
        "browserQaTargetUrl": { "type": "string", "minLength": 1 },
        "localPlaywrightMcpStatus": { "type": "string", "minLength": 1 },
        "requiredViewports": { "type": "string", "minLength": 1 },
        "browserAccessBlockers": { "type": "string", "minLength": 1 },
        "screenshotPolicy": { "type": "string", "minLength": 1 },
        "checksToRun": { "type": "string", "minLength": 1 },
        "projectLocalPlaywrightCommand": { "type": "string", "minLength": 1 },
        "serverVerificationResult": { "type": "string", "minLength": 1 },
        "cacheState": { "type": "string", "minLength": 1 },
        "knownRisks": { "type": "string", "minLength": 1 },
        "qaResult": { "type": "string", "minLength": 1 }
      }
    },
    "openQuestions": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string", "minLength": 1 }
    }
  }
}
